        "x": { "value": { "expr": "width / 2" } },
        "y": { "value": { "expr": "height / 2" } }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "color": "#666666",
        "dy": 24
      },
      "encoding": {
        "text": { "field": "__0__", "type": "nominal" },
        "x": { "value": { "expr": "width / 2" } },
        "y": { "value": { "expr": "height / 2" } }
      }
    }
  ]
